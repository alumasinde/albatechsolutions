APP_NAME="AlbaTech Solutions"
APP_ENV=production
APP_DEBUG=false
# Must exactly match your canonical domain (including www/non-www) as
# forced by your host's domain redirect setting — a mismatch here
# causes asset/stylesheet loads to silently fail under CSP due to an
# origin mismatch between the page and the generated asset URLs.
APP_URL=https://albatechsolutions.co.ke
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=
APP_RELEASE=v4.0.0
MAINTENANCE_MODE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=albatech_platform
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_NAME=albatech_session
SESSION_SAMESITE=Lax

# Change this to move the login form off a guessable default path.
LOGIN_PATH=/login

# Change this to move the admin panel off a guessable default path.
ADMIN_PATH=/admin

# Google Sign-In (customers only) — from Google Cloud Console > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://albatechsolutions.co.ke/auth/google/callback

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@albatechsolutions.co.ke
MAIL_FROM_NAME="AlbaTech Solutions"

PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
PAYSTACK_CALLBACK_URL=https://albatechsolutions.co.ke/payments/paystack/callback

# Daraja/M-Pesa direct integration removed for now (Paystack covers M-Pesa checkout).
# Uncomment and restore config/mpesa.php + DarajaClient/MpesaCallbackController when ready.
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# Must exactly match your canonical domain (see APP_URL note above) —
# Safaricom calls this URL directly and won't retry on a redirect.
# MPESA_CALLBACK_URL=https://www.albatechsolutions.co.ke/payments/mpesa/callback

TRUSTED_PROXIES=

# Sentry error monitoring (leave DSN blank to disable locally)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1

# Multi-channel customer notifications
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_MINUTES=5

# SMS provider (generic JSON adapter)
SMS_ENABLED=false
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=ALBATECH

# WhatsApp Cloud API (approved transactional templates required)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
