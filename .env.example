APP_NAME="AlbaTech Solutions"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://albatechsolutions.co.ke
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=
APP_RELEASE=v4.0.0
MAINTENANCE_MODE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=albatech_platform
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_NAME=albatech_session
SESSION_SAMESITE=Lax

LOGIN_PATH=/login
ADMIN_PATH=/admin

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://albatechsolutions.co.ke/auth/google/callback

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@albatechsolutions.co.ke
MAIL_FROM_NAME="AlbaTech Solutions"

PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
PAYSTACK_CALLBACK_URL=https://albatechsolutions.co.ke/payments/paystack/callback

TRUSTED_PROXIES=

SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1
TOKEN_RATE_LIMIT_MAX_ATTEMPTS=30
TOKEN_RATE_LIMIT_DECAY_MINUTES=1

NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_MINUTES=5

SMS_ENABLED=false
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=ALBATECH

WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional server-side GitHub deployment integration.
# Never put a PAT here or in the database/admin UI.
GIT_AUTO_PULL=false
GIT_WEBHOOK_SECRET=
GIT_GITHUB_REPO=alumasinde/albatechsolutions
GIT_DEPLOY_BRANCH=main
