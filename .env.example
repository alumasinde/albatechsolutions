APP_NAME="AlbaTech Solutions"
APP_ENV=local
APP_DEBUG=true

# In production set APP_ENV=production, APP_DEBUG=false and APP_URL=https://your-domain
APP_URL=http://albatechsolution.test:8000
APP_TIMEZONE=Africa/Nairobi

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=albatechsolutions
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=albatech_session
# Configure WhatsApp destination through Admin → Settings (not .env).

# SMTP email delivery for the public enquiry form. Use credentials from your mail provider.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-mailbox@example.com
MAIL_PASSWORD=replace-with-mailbox-or-app-password
MAIL_FROM_ADDRESS=your-mailbox@example.com
MAIL_FROM_NAME="AlbaTech Solutions"
# Optional fallback recipient if Admin Settings has no valid contact/support email.
MAIL_TO=

SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
SESSION_SECURE_COOKIE=false
