{
  "name": "albatech/albatechsolutions",
  "description": "AlbaTech Solutions website",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "vlucas/phpdotenv": "^5.7"
  },
  "autoload": {
    "psr-4": {
      "AlbaTech\\": "app/"
    }
  },
  "scripts": {
    "serve": [
        "Composer\\Config::disableProcessTimeout",
        "php -S albatechsolution.test:8000 -t public"
    ],
    "serve:lan": [
        "Composer\\Config::disableProcessTimeout",
        "php -S 0.0.0.0:8000 -t public"
    ]
},
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
