{
    "name": "albatech/digital-services-platform",
    "description": "AlbaTech Solutions Digital Services Platform - framework-free enterprise PHP",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "dompdf/dompdf": "^3.0",
        "guzzlehttp/guzzle": "^7.9",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "sentry/sentry": "4.30",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "qa": "php bin/qa.php",
        "qa:sql": "php bin/qa.php --skip-syntax",
        "qa:db": "php bin/db-smoke.php"
    }
}
