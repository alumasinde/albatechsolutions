{
  "name": "albatech/albatechsolutions",
  "description": "AlbaTech Solutions website",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "autoload": {
    "psr-4": {
      "AlbaTech\\": "app/"
    }
  },
  "scripts": {
    "migrate": "php bin/migrate.php",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "php -S albatechsolution.test:8000 -t public"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
