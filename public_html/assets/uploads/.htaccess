Options -Indexes

# Uploaded media must never be executable as PHP or another server-side script.
<FilesMatch "\.(?:php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh
